# Copia este archivo como .env.local y completa los valores.
# Los encuentras en Supabase → Project Settings → API (o con `npx supabase status` en local).

# URL pública del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (sb_publishable_...) o, en proyectos antiguos, la "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL donde corre esta app (se usa en los enlaces de los correos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SOLO servidor. Clave secreta (sb_secret_...) o "service_role".
# Se usa únicamente para eliminar cuentas a petición de la persona usuaria.
# Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
